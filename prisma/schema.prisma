// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // ou mysql / postgres
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  annonces          Annonce[]             @relation("CreatorAnnonces")
  events            Event[]               @relation("CreatorEvents")
  participations    EventParticipant[]    @relation("UserParticipations")
}

model Annonce {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation("CreatorAnnonces", fields: [userId], references: [id])
}

model Event {
  id           String             @id @default(uuid())
  title        String
  description  String
  dateStart    DateTime
  dateEnd      DateTime
  location     String?
  creatorId    String
  creator      User               @relation("CreatorEvents", fields: [creatorId], references: [id])
  participants EventParticipant[] // liste des participants
  createdAt    DateTime           @default(now())

  // Simple champ pour stocker un id d'annonce sans relation Prisma
  annonceId    Int?
}

model EventParticipant {
  id       String    @id @default(uuid())
  eventId  String
  userId   String
  status   String    @default("invited")
  joinedAt DateTime?

  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation("UserParticipations", fields: [userId], references: [id])

  // Garde seulement l'id si nécessaire, pas de relation inverse
  annonceId Int?
}
